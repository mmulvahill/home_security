# Home Security Stack - Cron Jobs
# Install with: sudo cp scripts/security-stack.cron /etc/cron.d/security-stack
# Then: sudo systemctl restart cron

# Health check every 5 minutes
*/5 * * * * root /opt/security-stack/scripts/health-check.sh >> /var/log/security-stack-health.log 2>&1

# Daily backup at 3 AM
0 3 * * * root /opt/security-stack/scripts/backup.sh >> /var/log/security-stack-backup.log 2>&1

# Weekly cleanup of old recordings (if needed, handled by Frigate)
# 0 4 * * 0 root docker exec frigate find /media/frigate/recordings -type f -mtime +14 -delete
